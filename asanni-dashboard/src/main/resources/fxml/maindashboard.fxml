<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.asanni.dashboard.controllers.MainDashboardController"
            prefHeight="840.0" prefWidth="1220.0"
            style="-fx-background-color: #CBC7BF;">

    <!-- Main Content -->
    <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                prefHeight="840.0" prefWidth="1220.0"
                style="-fx-background: #CBC7BF; -fx-background-color: #CBC7BF;"
                stylesheets="@../css/global.css, @../css/MainDashboard.css">

        <VBox spacing="18.0" styleClass="dashboard-root">
        <padding>
            <Insets bottom="24.0" left="28.0" right="28.0" top="20.0"/>
        </padding>

        <!-- ==================== TOP NAVBAR ==================== -->
        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="top-navbar">
            <Label fx:id="logoBadge" styleClass="logo-badge" text="AS" onMouseClicked="#handleLogoClick"/>
            <VBox alignment="CENTER_LEFT" spacing="1.0">
                <Label styleClass="eyebrow-red" text="OWNER DASHBOARD"/>
                <Label fx:id="navBrandLabel" styleClass="brand-title" text="Asanni · Zamzama"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button onAction="#handleHelp" styleClass="pill-button-outline" text="Help" graphicTextGap="8.0">
                <graphic>
                    <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17h-2v-2h2v2zm2.07-7.75l-.9.92C13.45 12.9 13 13.5 13 15h-2v-.5c0-1.1.45-2.1 1.17-2.83l1.24-1.26c.37-.36.59-.86.59-1.41 0-1.1-.9-2-2-2s-2 .9-2 2H8c0-2.21 1.79-4 4-4s4 1.79 4 4c0 .88-.36 1.68-.93 2.25z"
                             fill="#111111" scaleX="0.75" scaleY="0.75"/>
                </graphic>
            </Button>
            <Label fx:id="avatarLabel" styleClass="avatar-circle" text="OA"/>
        </HBox>

        <!-- ==================== MAIN CONTENT AREA ==================== -->
        <HBox spacing="20.0" VBox.vgrow="ALWAYS">

            <!-- LEFT SIDEBAR (QUICK ACCESS NAVIGATION) -->
            <VBox minWidth="265.0" prefWidth="265.0" spacing="16.0" styleClass="surface-card">
                <VBox spacing="6.0">
                    <Label styleClass="eyebrow-red" text="NAVIGATION"/>
                    <Label styleClass="sidebar-heading" text="Quick access"/>
                    <Label styleClass="muted-text" text="Jump between live controls, preview and settings."/>
                </VBox>

                <VBox spacing="10.0">
                    <VBox.margin>
                        <Insets top="8.0"/>
                    </VBox.margin>

                    <!-- Nav 1: Dashboard (Active) -->
                    <HBox fx:id="navDashboard" onMouseClicked="#handleNavDashboard"
                          alignment="CENTER_LEFT" spacing="12.0" styleClass="nav-card, nav-card-active">
                        <StackPane styleClass="nav-icon-active">
                            <SVGPath content="M3 3h8v8H3V3zm10 0h8v8h-8V3zM3 13h8v8H3v-8zm10 0h8v8h-8v-8z"
                                     fill="#FFFFFF" scaleX="0.65" scaleY="0.65"/>
                        </StackPane>
                        <VBox spacing="2.0">
                            <Label styleClass="nav-title" text="Dashboard"/>
                            <Label styleClass="nav-subtitle-active" text="Current view"/>
                        </VBox>
                    </HBox>

                    <!-- Nav 2: Tables -->
                    <HBox fx:id="navTables" onMouseClicked="#handleNavTables"
                          alignment="CENTER_LEFT" spacing="12.0" styleClass="nav-card">
                        <StackPane styleClass="nav-icon-default">
                            <SVGPath content="M20 10V7c0-1.1-.9-2-2-2H6c-1.1 0-2 .9-2 2v3c-1.1 0-2 .9-2 2v5h1.33L4 19h1l.67-2h12.67l.66 2h1l.67-2H22v-5c0-1.1-.9-2-2-2zm-2-3v3H6V7h12z"
                                     fill="#5A5650" scaleX="0.7" scaleY="0.7"/>
                        </StackPane>
                        <VBox spacing="2.0">
                            <Label styleClass="nav-title" text="Tables"/>
                            <Label styleClass="nav-subtitle" text="Live seating controls"/>
                        </VBox>
                    </HBox>

                    <!-- Nav 3: Preview -->
                    <HBox fx:id="navPreview" onMouseClicked="#handleNavPreview"
                          alignment="CENTER_LEFT" spacing="12.0" styleClass="nav-card">
                        <StackPane styleClass="nav-icon-default">
                            <SVGPath content="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"
                                     fill="#5A5650" scaleX="0.7" scaleY="0.7"/>
                        </StackPane>
                        <VBox spacing="2.0">
                            <Label styleClass="nav-title" text="Preview"/>
                            <Label styleClass="nav-subtitle" text="Customer-facing view"/>
                        </VBox>
                    </HBox>

                    <!-- Nav 4: Waiting Control -->
                    <HBox fx:id="navWaitingControl" onMouseClicked="#handleNavWaitingControl"
                          alignment="CENTER_LEFT" spacing="12.0" styleClass="nav-card">
                        <StackPane styleClass="nav-icon-default">
                            <SVGPath content="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"
                                     fill="#5A5650" scaleX="0.7" scaleY="0.7"/>
                        </StackPane>
                        <VBox spacing="2.0">
                            <Label styleClass="nav-title" text="Waiting Control"/>
                            <Label styleClass="nav-subtitle" text="Wait time &amp; status"/>
                        </VBox>
                    </HBox>

                    <!-- Nav 5: Settings -->
                    <HBox fx:id="navSettings" onMouseClicked="#handleNavSettings"
                          alignment="CENTER_LEFT" spacing="12.0" styleClass="nav-card">
                        <StackPane styleClass="nav-icon-default">
                            <SVGPath content="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"
                                     fill="#5A5650" scaleX="0.7" scaleY="0.7"/>
                        </StackPane>
                        <VBox spacing="2.0">
                            <Label styleClass="nav-title" text="Edit Restraunt"/>
                            <Label styleClass="nav-subtitle" text="Edit Public View"/>
                        </VBox>
                    </HBox>
                </VBox>
            </VBox>

            <!-- RIGHT WORKSPACE -->
            <VBox spacing="18.0" HBox.hgrow="ALWAYS">

                <!-- 1. TOP BANNER CARD -->
                <VBox spacing="6.0" styleClass="header-banner-card">
                    <Label styleClass="eyebrow-red" text="OWNER DASHBOARD"/>
                    <Label fx:id="headerTitleLabel" styleClass="heading" text="Asanni · Zamzama"/>
                    <Label styleClass="subtitle" text="Live visibility, table capacity and customer activity in one place."/>
                </VBox>

                <!-- 2. THREE STAT CARDS (TOTAL, FREE, OCCUPIED) -->
                <HBox spacing="18.0">
                    <!-- Total Tables -->
                    <VBox prefHeight="118.0" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="metric-card">
                        <Label fx:id="totalTablesLabel" styleClass="metric-value" text="18"/>
                        <Region VBox.vgrow="ALWAYS"/>
                        <Label styleClass="metric-caption" text="Total tables"/>
                    </VBox>

                    <!-- Free Now -->
                    <VBox prefHeight="118.0" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="metric-card">
                        <Label fx:id="freeTablesLabel" styleClass="metric-value" text="6"/>
                        <Region VBox.vgrow="ALWAYS"/>
                        <Label styleClass="metric-caption" text="Free now"/>
                    </VBox>

                    <!-- Occupied -->
                    <VBox prefHeight="118.0" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="metric-card">
                        <Label fx:id="occupiedTablesLabel" styleClass="metric-value" text="12"/>
                        <Region VBox.vgrow="ALWAYS"/>
                        <Label styleClass="metric-caption" text="Occupied"/>
                    </VBox>
                </HBox>

                <!-- 3. TWO ACTION CARDS (UPDATE TABLES & SET WAIT TIME) -->
                <HBox spacing="18.0">
                    <!-- Primary Red Action Card: Update Tables -->
                    <VBox onMouseClicked="#handleUpdateTables" prefHeight="112.0" prefWidth="520.0"
                          HBox.hgrow="ALWAYS" styleClass="action-card-primary">
                        <StackPane alignment="TOP_LEFT" maxWidth="-Infinity">
                            <SVGPath content="M20 10V7c0-1.1-.9-2-2-2H6c-1.1 0-2 .9-2 2v3c-1.1 0-2 .9-2 2v5h1.33L4 19h1l.67-2h12.67l.66 2h1l.67-2H22v-5c0-1.1-.9-2-2-2zm-2-3v3H6V7h12z"
                                     fill="#FFFFFF" scaleX="0.85" scaleY="0.85"/>
                        </StackPane>
                        <Region VBox.vgrow="ALWAYS"/>
                        <Label fx:id="updateTablesActionLabel" styleClass="action-title-primary" text="Update tables"/>
                    </VBox>

                    <!-- Secondary Surface Action Card: Set Wait Time -->
                    <VBox onMouseClicked="#handleSetWaitTime" prefHeight="112.0" prefWidth="360.0"
                          HBox.hgrow="ALWAYS" styleClass="action-card-secondary">
                        <StackPane alignment="TOP_LEFT" maxWidth="-Infinity">
                            <SVGPath content="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"
                                     fill="#2B2927" scaleX="0.85" scaleY="0.85"/>
                        </StackPane>
                        <Region VBox.vgrow="ALWAYS"/>
                        <Label fx:id="waitTimeActionLabel" styleClass="action-title-secondary" text="Set wait time"/>
                    </VBox>
                </HBox>

                <!-- 4. SERVICE PULSE CARD -->
                <VBox spacing="22.0" styleClass="pulse-card" VBox.vgrow="ALWAYS">
                    <!-- Top Header Row -->
                    <HBox alignment="TOP_LEFT">
                        <VBox spacing="4.0">
                            <Label styleClass="pulse-heading" text="Service pulse"/>
                            <Label styleClass="muted-text" text="Customer profile views"/>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <VBox alignment="TOP_RIGHT" spacing="4.0">
                            <Label styleClass="pulse-today-label" text="Today"/>
                            <Label fx:id="profileViewsLabel" styleClass="pulse-views-count" text="284"/>
                        </VBox>
                    </HBox>

                    <!-- Bar Chart Row (10 Rounded Bars) -->
                    <HBox fx:id="pulseBarsContainer" alignment="BOTTOM_CENTER" spacing="12.0" prefHeight="95.0">
                        <Region prefHeight="22.0" maxHeight="22.0" HBox.hgrow="ALWAYS" styleClass="pulse-bar"/>
                        <Region prefHeight="32.0" maxHeight="32.0" HBox.hgrow="ALWAYS" styleClass="pulse-bar"/>
                        <Region prefHeight="25.0" maxHeight="25.0" HBox.hgrow="ALWAYS" styleClass="pulse-bar"/>
                        <Region prefHeight="46.0" maxHeight="46.0" HBox.hgrow="ALWAYS" styleClass="pulse-bar"/>
                        <Region prefHeight="55.0" maxHeight="55.0" HBox.hgrow="ALWAYS" styleClass="pulse-bar"/>
                        <Region prefHeight="38.0" maxHeight="38.0" HBox.hgrow="ALWAYS" styleClass="pulse-bar"/>
                        <!-- Highlighted Peak Bar -->
                        <Region prefHeight="68.0" maxHeight="68.0" HBox.hgrow="ALWAYS" styleClass="pulse-bar, pulse-bar-active"/>
                        <Region prefHeight="48.0" maxHeight="48.0" HBox.hgrow="ALWAYS" styleClass="pulse-bar"/>
                        <Region prefHeight="32.0" maxHeight="32.0" HBox.hgrow="ALWAYS" styleClass="pulse-bar"/>
                        <Region prefHeight="25.0" maxHeight="25.0" HBox.hgrow="ALWAYS" styleClass="pulse-bar"/>
                    </HBox>

                    <Region VBox.vgrow="ALWAYS"/>
                </VBox>

            </VBox>
        </HBox>
    </VBox>
    </ScrollPane>

    <!-- Loading Screen Overlay -->
    <StackPane fx:id="loadingOverlay" style="-fx-background-color: #CBC7BF;">
        <VBox alignment="CENTER" spacing="20.0">
            <StackPane>
                <Circle fx:id="spinnerCircle" fill="transparent" radius="30.0" stroke="#B3262E" strokeWidth="3.0"/>
            </StackPane>
            <Label fx:id="loadingLabel" styleClass="loading-text" text="Loading..."/>
        </VBox>
    </StackPane>
</StackPane>