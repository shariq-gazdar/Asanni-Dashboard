<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.asanni.dashboard.controllers.WaitingControlController"
            prefHeight="840.0" prefWidth="1220.0"
            style="-fx-background-color: #CBC7BF;">

    <!-- Main Content -->
    <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                prefHeight="840.0" prefWidth="1220.0"
                style="-fx-background: #CBC7BF; -fx-background-color: #CBC7BF;"
                stylesheets="@../css/global.css, @../css/WaitingControl.css">

        <VBox spacing="18.0" styleClass="waiting-root">
        <padding>
            <Insets bottom="24.0" left="28.0" right="28.0" top="20.0"/>
        </padding>

        <!-- ==================== TOP NAVBAR ==================== -->
        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="top-navbar">
            <Label fx:id="logoBadge" styleClass="logo-badge" text="AS" onMouseClicked="#handleLogoClick"/>
            <VBox alignment="CENTER_LEFT" spacing="1.0">
                <Label styleClass="eyebrow-red" text="PARTNER PORTAL"/>
                <Label fx:id="navBrandLabel" styleClass="brand-title" text="Asanni"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button onAction="#handleHelp" styleClass="pill-button-outline" text="Help" graphicTextGap="8.0">
                <graphic>
                    <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17h-2v-2h2v2zm2.07-7.75l-.9.92C13.45 12.9 13 13.5 13 15h-2v-.5c0-1.1.45-2.1 1.17-2.83l1.24-1.26c.37-.36.59-.86.59-1.41 0-1.1-.9-2-2-2s-2 .9-2 2H8c0-2.21 1.79-4 4-4s4 1.79 4 4c0 .88-.36 1.68-.93 2.25z"
                             fill="#111111" scaleX="0.75" scaleY="0.75"/>
                </graphic>
            </Button>
            <Label fx:id="avatarLabel" styleClass="avatar-circle" text="OA"/>
        </HBox>

        <!-- ==================== MAIN CONTENT AREA ==================== -->
        <HBox spacing="20.0" VBox.vgrow="ALWAYS">

            <!-- LEFT SIDEBAR: STATUS -->
            <VBox minWidth="265.0" prefWidth="265.0" spacing="16.0" styleClass="surface-card">
                <VBox spacing="6.0">
                    <Label styleClass="eyebrow-red" text="STATUS"/>
                    <Label fx:id="statusHeadingLabel" styleClass="sidebar-heading" text="All tables closed"/>
                    <Label fx:id="statusSubLabel" styleClass="muted-text" text="Customers see you as unavailable until tables reopen."/>
                </VBox>

                <!-- Warm Amber Tip Box -->
                <VBox fx:id="tipCard" spacing="10.0" styleClass="amber-tip-card">
                    <VBox.margin>
                        <Insets top="4.0"/>
                    </VBox.margin>
                    <StackPane alignment="TOP_LEFT" maxWidth="-Infinity">
                        <SVGPath content="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"
                                 fill="#9A5B13" scaleX="0.75" scaleY="0.75"/>
                    </StackPane>
                    <Label fx:id="tipTextLabel" styleClass="amber-tip-text"
                           text="If you expect to reopen soon, publish a waiting time instead."
                           wrapText="true"/>
                </VBox>
            </VBox>

            <!-- RIGHT WORKSPACE -->
            <VBox spacing="22.0" HBox.hgrow="ALWAYS">

                <!-- 1. HERO BANNER (dynamic theme) -->
                <StackPane fx:id="heroBanner" prefHeight="210.0" styleClass="closed-hero-banner">
                    <StackPane fx:id="heroCircle" styleClass="closed-hero-circle">
                        <SVGPath content="M19 19V4h-4V3H5v16H3v2h12V6h2v15h4v-2h-2zm-6 0H7V5h6v14zm-3-8h2v2h-2v-2z"
                                 fill="#F9ECEC" scaleX="1.15" scaleY="1.15"/>
                    </StackPane>
                </StackPane>

                <!-- 2. CENTERED STATUS HEADING & SUBTITLE -->
                <VBox alignment="CENTER" spacing="10.0">
                    <VBox.margin>
                        <Insets top="4.0"/>
                    </VBox.margin>
                    <Label fx:id="heroPillBadge" styleClass="closed-pill-badge" text="●   ALL TABLES CLOSED"/>
                    <Label fx:id="heroHeadingLabel" styleClass="closed-main-heading" text="Customers see you as unavailable."/>
                    <Label fx:id="heroSubtitleLabel" styleClass="muted-text"
                           text="Your profile stays visible, but live discovery shows &quot;No tables right now.&quot;"/>
                </VBox>

                <!-- 3. WAIT TIME INPUT (shown when acceptingDiners is false) -->
                <VBox fx:id="waitTimeInputBox" alignment="CENTER" spacing="12.0" styleClass="wait-time-input-card" visible="false" managed="false">
                    <Label styleClass="input-label" text="Set waiting time (minutes)"/>
                    <TextField fx:id="waitTimeTextField" maxWidth="200.0" promptText="e.g., 15"/>
                    <Button maxWidth="Infinity" onAction="#handlePublishWaitTime" styleClass="publish-wait-button" text="Publish waiting time"/>
                </VBox>

                <!-- 4. CUSTOMER-FACING STATUS CARD -->
                <VBox spacing="12.0" styleClass="customer-status-card">
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="eyebrow-muted" text="CUSTOMER-FACING STATUS"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button onAction="#handlePreviewClick" styleClass="icon-button-transparent">
                            <graphic>
                                <SVGPath content="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"
                                         fill="#6E6A63" scaleX="0.7" scaleY="0.7"/>
                            </graphic>
                        </Button>
                    </HBox>

                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="3.0">
                            <Label fx:id="previewRestaurantLabel" styleClass="brand-title" text="Asanni"/>
                            <Label fx:id="updatedTimeLabel" styleClass="muted-text-small" text="Updated just now"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="customerStatusBadge" styleClass="no-tables-badge" text="●  No tables"/>
                    </HBox>
                </VBox>

                <!-- 5. REOPEN BUTTON -->
                <VBox fx:id="reopenButtonBox" alignment="CENTER" spacing="12.0">
                    <Button fx:id="reopenButton" maxWidth="Infinity" onAction="#handleReopenTableControls"
                            styleClass="reopen-button" text="Reopen table controls" graphicTextGap="10.0">
                        <graphic>
                            <SVGPath content="M12 17c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm6-9h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6h1.9c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm0 12H6V10h12v10z"
                                     fill="#FFFFFF" scaleX="0.75" scaleY="0.75"/>
                        </graphic>
                    </Button>
                </VBox>

            </VBox>
        </HBox>
    </VBox>
    </ScrollPane>

    <!-- Loading Screen Overlay -->
    <StackPane fx:id="loadingOverlay" style="-fx-background-color: #CBC7BF;">
        <VBox alignment="CENTER" spacing="20.0">
            <StackPane>
                <Circle fx:id="spinnerCircle" fill="transparent" radius="30.0" stroke="#B3262E" strokeWidth="3.0"/>
            </StackPane>
            <Label fx:id="loadingLabel" styleClass="loading-text" text="Loading..."/>
        </VBox>
    </StackPane>
</StackPane>