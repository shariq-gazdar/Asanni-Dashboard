<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>

<StackPane fx:id="rootPane"
            minHeight="0.0" minWidth="0.0"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.asanni.dashboard.controllers.LoadingScreenController"
           styleClass="loading-root"
           stylesheets="@../css/global.css, @../css/LoadingScreen.css">

    <!-- Full-Screen Animated GIF Loader -->
    <ImageView fx:id="loadingGif"
               fitWidth="${rootPane.width}"
               fitHeight="${rootPane.height}"
               pickOnBounds="true"
               preserveRatio="false"
               styleClass="loading-gif">
        <image>
            <Image url="@../assets/loader.gif" />
        </image>
    </ImageView>

</StackPane>