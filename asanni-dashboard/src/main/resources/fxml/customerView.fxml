<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.asanni.dashboard.controllers.CustomerViewController"
           stylesheets="@../css/global.css, @../css/customerView.css">

    <!-- Main Scrollable Page -->
    <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" styleClass="page-scroll">
        <content>
            <VBox spacing="18.0" styleClass="page-root">
                <padding>
                    <Insets top="20.0" right="24.0" bottom="24.0" left="24.0"/>
                </padding>

                <!-- ==================== TOP NAVBAR ==================== -->
                <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="top-navbar">
                    <padding>
                        <Insets top="12.0" right="18.0" bottom="12.0" left="18.0"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT" spacing="12.0" onMouseClicked="#handleExitPreview" style="-fx-cursor: hand;">
                        <Label fx:id="logoBadge" alignment="CENTER" prefHeight="38.0" prefWidth="38.0" styleClass="brand-badge" text="--"/>
                        <VBox alignment="CENTER_LEFT" spacing="1.0">
                            <Label styleClass="portal-kicker" text="PARTNER PORTAL"/>
                            <Label fx:id="navBrandLabel" styleClass="portal-brand" text="Loading..."/>
                        </VBox>
                    </HBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button onAction="#handleHelp" styleClass="help-btn" text="Help">
                        <graphic>
                            <StackPane prefHeight="16.0" prefWidth="16.0" styleClass="help-icon-circle">
                                <Label styleClass="help-icon-question" text="?"/>
                            </StackPane>
                        </graphic>
                    </Button>

                    <Label fx:id="avatarLabel" alignment="CENTER" prefHeight="38.0" prefWidth="38.0" styleClass="avatar-badge" text="--"/>
                </HBox>

                <!-- ==================== MAIN 2-COLUMN BODY ==================== -->
                <HBox spacing="18.0" VBox.vgrow="ALWAYS">

                    <!-- LEFT SIDEBAR -->
                    <VBox prefWidth="245.0" minWidth="230.0" maxWidth="260.0" spacing="14.0" styleClass="sidebar-card">
                        <padding>
                            <Insets top="22.0" right="18.0" bottom="22.0" left="18.0"/>
                        </padding>

                        <VBox spacing="6.0">
                            <Label styleClass="section-kicker" text="PREVIEW"/>
                            <Label styleClass="sidebar-title" text="Customer preview"/>
                            <Label styleClass="sidebar-subtitle" text="Review how your live listing appears to diners." wrapText="true"/>
                        </VBox>

                        <VBox spacing="10.0">
                            <VBox.margin>
                                <Insets top="6.0"/>
                            </VBox.margin>

                            <!-- Exit preview button -->
                            <Button maxWidth="Infinity" onAction="#handleExitPreview" styleClass="sidebar-action-btn" text="Exit preview">
                                <graphic>
                                    <SVGPath content="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"
                                             scaleX="0.68" scaleY="0.68" styleClass="sidebar-btn-icon"/>
                                </graphic>
                            </Button>

                            <!-- Get directions button -->
                            <Button maxWidth="Infinity" onAction="#handleGetDirections" styleClass="sidebar-action-btn" text="Get directions">
                                <graphic>
                                    <SVGPath content="M21 3L3 10.53v.98l6.84 2.65L12.48 21h.98L21 3z"
                                             scaleX="0.68" scaleY="0.68" styleClass="sidebar-btn-icon"/>
                                </graphic>
                            </Button>
                        </VBox>
                    </VBox>

                    <!-- RIGHT MAIN PREVIEW COLUMN -->
                    <VBox spacing="16.0" HBox.hgrow="ALWAYS">

                        <!-- 1. Header Card -->
                        <VBox spacing="6.0" styleClass="preview-header-card">
                            <padding>
                                <Insets top="22.0" right="24.0" bottom="22.0" left="24.0"/>
                            </padding>
                            <Label styleClass="section-kicker" text="CUSTOMER PREVIEW · LIVE"/>
                            <Label fx:id="restaurantTitleLabel" styleClass="restaurant-main-title" text="Loading restaurant..."/>
                            <Label fx:id="restaurantMetaLabel" styleClass="restaurant-meta-subtitle" text="Fetching details from Firestore..."/>
                        </VBox>

                        <!-- 2. Cover Photo Banner -->
                        <StackPane fx:id="coverContainer" prefHeight="225.0" minHeight="225.0" maxHeight="225.0" styleClass="cover-container">
                            <ImageView fx:id="coverImageView" fitHeight="225.0" pickOnBounds="true" preserveRatio="false">
                                <image>
                                    <Image url="https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&amp;fit=crop&amp;w=1200&amp;q=80" backgroundLoading="true"/>
                                </image>
                            </ImageView>

                            <!-- Featured Pill Top-Left -->
                            <HBox fx:id="featuredOverlayBadge" alignment="CENTER_LEFT" spacing="5.0" maxWidth="-Infinity" maxHeight="-Infinity"
                                  styleClass="featured-overlay-pill" StackPane.alignment="TOP_LEFT">
                                <StackPane.margin>
                                    <Insets top="16.0" left="16.0"/>
                                </StackPane.margin>
                                <Label styleClass="featured-sparkle" text="✦"/>
                                <Label styleClass="featured-pill-text" text="FEATURED"/>
                            </HBox>
                        </StackPane>

                        <!-- 3. Wait / Live Status Banner -->
                        <VBox fx:id="waitBannerCard" spacing="10.0" styleClass="wait-banner-green">
                            <padding>
                                <Insets top="20.0" right="24.0" bottom="20.0" left="24.0"/>
                            </padding>

                            <HBox alignment="CENTER_LEFT">
                                <Label fx:id="waitPillLabel" styleClass="wait-kicker-amber, wait-text-green" text="●  NO WAIT TIME"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="updatedAtLabel" styleClass="wait-updated-amber, wait-text-green" text="Updated recently"/>
                            </HBox>

                            <Label fx:id="waitHeadlineLabel" styleClass="wait-headline-amber, wait-text-green" text="No wait time"/>
                            <Label fx:id="waitSubtextLabel" styleClass="wait-subtext-amber, wait-text-green" text="Customers can walk in immediately with no waiting time."/>
                        </VBox>

                        <!-- 4. Distance & Open Hours Cards Row -->
                        <HBox spacing="16.0">
                            <!-- Distance Card -->
                            <VBox spacing="6.0" styleClass="info-mini-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                <padding>
                                    <Insets top="18.0" right="20.0" bottom="18.0" left="20.0"/>
                                </padding>
                                <SVGPath content="M21 3L3 10.53v.98l6.84 2.65L12.48 21h.98L21 3z"
                                         scaleX="0.72" scaleY="0.72" styleClass="info-card-icon"/>
                                <Label fx:id="distanceTitleLabel" styleClass="info-card-title" text="-- km"/>
                                <Label fx:id="distanceSubLabel" styleClass="info-card-sub" text="Checking location..."/>
                            </VBox>

                            <!-- Hours Card -->
                            <VBox spacing="6.0" styleClass="info-mini-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                <padding>
                                    <Insets top="18.0" right="20.0" bottom="18.0" left="20.0"/>
                                </padding>
                                <SVGPath content="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.5-13H11v6l5.2 3.2.8-1.3-4.5-2.7V7z"
                                         scaleX="0.72" scaleY="0.72" styleClass="info-card-icon"/>
                                <Label fx:id="openStatusTitleLabel" styleClass="info-card-title" text="Open now"/>
                                <Label fx:id="openStatusSubLabel" styleClass="info-card-sub" text="Checking tables..."/>
                            </VBox>
                        </HBox>

                        <!-- 5. Directions / Address Row -->
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <VBox.margin>
                                <Insets top="2.0" bottom="2.0"/>
                            </VBox.margin>
                            <StackPane prefHeight="34.0" prefWidth="34.0" styleClass="pin-icon-circle">
                                <SVGPath content="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                                         scaleX="0.68" scaleY="0.68" styleClass="pin-svg"/>
                            </StackPane>
                            <VBox spacing="1.0">
                                <Label styleClass="directions-kicker" text="Directions"/>
                                <Label fx:id="addressLabel" styleClass="directions-address" text="Loading address..."/>
                            </VBox>
                        </HBox>

                        <!-- 6. Amenity & Featured Tags -->
                        <FlowPane fx:id="tagsFlowPane" hgap="8.0" vgap="8.0"/>

                        <!-- 7. Primary Bottom CTA Button -->
                        <Button maxWidth="Infinity" onAction="#handleGetDirections" styleClass="primary-directions-btn" text="Get directions">
                            <graphic>
                                <SVGPath content="M21 3L3 10.53v.98l6.84 2.65L12.48 21h.98L21 3z"
                                         scaleX="0.72" scaleY="0.72" styleClass="primary-btn-icon"/>
                            </graphic>
                        </Button>

                    </VBox>
                </HBox>
            </VBox>
        </content>
    </ScrollPane>

    <!-- ==================== FULL-SCREEN GIF LOADING OVERLAY ==================== -->
    <StackPane fx:id="loadingOverlay" style="-fx-background-color: #CBC7BF;" visible="true"/>

</StackPane>