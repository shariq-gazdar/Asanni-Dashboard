<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            stylesheets="@/css/PlanSelect.css"
            fx:controller="com.asanni.dashboard.controllers.PlanSelectController"
            fitToWidth="true"
            fitToHeight="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            prefWidth="1000" prefHeight="700"
            style="-fx-background: transparent; -fx-background-color: transparent;">

    <VBox styleClass="root-container">
        <!-- ================= HEADER ================= -->
        <HBox styleClass="header" alignment="CENTER_LEFT" spacing="15">
            <padding><Insets top="15" right="30" bottom="15" left="30"/></padding>
            
            <!-- Logo placeholder -->
            <Label text="■" styleClass="logo-icon"/>
            
            <VBox spacing="2">
                <Label text="PARTNER PORTAL" styleClass="header-brand-small"/>
                <Label text="Asanni" styleClass="header-brand-large"/>
            </VBox>
            
            <Region HBox.hgrow="ALWAYS"/> <!-- Spacer -->
            
            <Button fx:id="helpButton" text="?" onAction="#handleHelp" styleClass="header-icon-button"/>
            <Button fx:id="profileButton" text="OM" onAction="#handleProfile" styleClass="header-profile-button"/>
        </HBox>

        <!-- ================= MAIN CONTENT ================= -->
        <HBox spacing="20" VBox.vgrow="ALWAYS">
            <padding><Insets top="20" right="30" bottom="30" left="30"/></padding>

            <!-- LEFT SIDEBAR -->
            <VBox spacing="15" styleClass="sidebar" prefWidth="280" minWidth="280">
                <Label text="ONBOARDING" styleClass="sidebar-title"/>
                <Label text="Choose your plan" styleClass="sidebar-heading"/>
                <Label text="Select the service level that matches your restaurant today." styleClass="sidebar-subtitle" wrapText="true"/>
                
                <!-- Step 1 (Active) -->
                <HBox spacing="10" alignment="CENTER_LEFT" styleClass="step-box">
                    <Label text="1" styleClass="step-circle-active"/>
                    <VBox spacing="2">
                        <Label text="Service plan" styleClass="step-title"/>
                        <Label text="Core features" styleClass="step-subtitle"/>
                    </VBox>
                </HBox>

                <!-- Step 2 -->
                <HBox spacing="10" alignment="CENTER_LEFT" styleClass="step-box">
                    <Label text="2" styleClass="step-circle"/>
                    <VBox spacing="2">
                        <Label text="Restaurant profile" styleClass="step-title"/>
                        <Label text="Identity and location" styleClass="step-subtitle"/>
                    </VBox>
                </HBox>

                <!-- Step 3 -->
                <HBox spacing="10" alignment="CENTER_LEFT" styleClass="step-box">
                    <Label text="3" styleClass="step-circle"/>
                    <VBox spacing="2">
                        <Label text="Featured listing" styleClass="step-title"/>
                        <Label text="Photos and amenities" styleClass="step-subtitle"/>
                    </VBox>
                </HBox>

                <!-- Recommended Badge -->
                <VBox spacing="10" styleClass="recommended-box">
                    <Label text="RECOMMENDED" styleClass="recommended-label"/>
                    <Label text="Featured plan" styleClass="step-title"/>
                    <Label text="Priority placement, richer profile media and city-wide promotion." styleClass="step-subtitle" wrapText="true"/>
                    <Label text="Selected" styleClass="selected-text"/>
                </VBox>

                <!-- Quick Login Section -->
                <VBox spacing="12" styleClass="billing-box">
                    <Label text="QUICK LOGIN" styleClass="sidebar-title"/>
                    <Label text="Enter your restaurant details to skip onboarding" styleClass="step-subtitle" wrapText="true"/>
                    <VBox spacing="8">
                        <Label text="Restaurant Name" styleClass="input-label"/>
                        <TextField fx:id="restaurantNameField" promptText="Enter restaurant name" styleClass="input-field"/>
                    </VBox>
                    <VBox spacing="8">
                        <Label text="Total Tables" styleClass="input-label"/>
                        <TextField fx:id="totalTablesField" promptText="Enter number of tables" styleClass="input-field"/>
                    </VBox>
                    <Button text="Login &amp; Go to Dashboard" onAction="#handleQuickLogin" styleClass="btn-quick-login" maxWidth="Infinity"/>
                </VBox>

                <!-- Billing Info -->
                <VBox spacing="5" styleClass="billing-box">
                    <Label text="BILLING" styleClass="sidebar-title"/>
                    <Label text="14-day trial, no charge today" styleClass="step-subtitle"/>
                </VBox>
            </VBox>

            <!-- RIGHT CONTENT -->
            <VBox spacing="20" HBox.hgrow="ALWAYS" styleClass="right-content">
                <Label text="STEP 1 OF 3" styleClass="step-indicator"/>
                <Label text="Choose how your restaurant goes live." styleClass="main-heading"/>
                <Label text="Both plans include five table controls and a customer-facing profile." styleClass="main-subtitle"/>

                <!-- Plans Container -->
                <HBox spacing="20" VBox.vgrow="ALWAYS">
                    
                    <!-- Essential Plan Card -->
                    <VBox spacing="15" styleClass="plan-card" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Essential" styleClass="plan-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="PKR 2,500/mo" styleClass="plan-price"/>
                        </HBox>
                        <Label text="Live tables, wait time, directions and standard discovery." styleClass="plan-desc" wrapText="true"/>
                        
                        <VBox spacing="10" styleClass="feature-list">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="✓" styleClass="check-icon"/>
                                <Label text="Unlimited live updates" styleClass="feature-text"/>
                            </HBox>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="✓" styleClass="check-icon"/>
                                <Label text="Included" styleClass="feature-text"/>
                            </HBox>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="✓" styleClass="check-icon"/>
                                <Label text="Owner dashboard" styleClass="feature-text"/>
                            </HBox>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS"/> <!-- Pushes button to bottom -->
                        
                        <Button text="➔ Choose Essential" onAction="#handleChooseEssential" styleClass="btn-choose-essential" maxWidth="Infinity"/>
                    </VBox>
                    <!-- Featured Plan Card (Dark) -->
                      <VBox spacing="15" styleClass="featured-card" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Featured" styleClass="featured-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="PKR 5,900/mo" styleClass="featured-price"/>
                        </HBox>
                        <Label text="Priority placement, richer profile media and city-wide promotion." styleClass="featured-desc" wrapText="true"/>
                        
                        <VBox spacing="10" styleClass="feature-list">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="✓" styleClass="check-icon"/>
                                <Label text="Unlimited live updates" styleClass="featured-text"/>
                            </HBox>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="✓" styleClass="check-icon"/>
                                <Label text="Included" styleClass="featured-text"/>
                            </HBox>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="✓" styleClass="check-icon"/>
                                <Label text="Owner dashboard" styleClass="featured-text"/>
                            </HBox>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS"/> <!-- Pushes button to bottom -->
                        
                        <Button text="➔ Choose Featured" onAction="#handleChooseFeatured" styleClass="btn-choose-essential" maxWidth="Infinity"/>
                    </VBox>

                </HBox>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>