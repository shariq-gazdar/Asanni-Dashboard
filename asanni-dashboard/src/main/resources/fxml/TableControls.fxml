<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.asanni.dashboard.controllers.TableControlsController"
            prefHeight="840.0" prefWidth="1220.0"
            style="-fx-background-color: #CBC7BF;">

    <!-- Main Content -->
    <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                prefHeight="840.0" prefWidth="1220.0"
                style="-fx-background: #CBC7BF; -fx-background-color: #CBC7BF;"
                stylesheets="@../css/global.css, @../css/TableControls.css">

        <VBox spacing="18.0" styleClass="dashboard-root">
        <padding>
            <Insets bottom="24.0" left="28.0" right="28.0" top="20.0"/>
        </padding>

        <!-- ==================== TOP NAVBAR ==================== -->
        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="top-navbar">
            <Label fx:id="logoBadge" styleClass="logo-badge" text="AS" onMouseClicked="#handleLogoClick"/>
            <VBox alignment="CENTER_LEFT" spacing="1.0">
                <Label styleClass="eyebrow-red" text="PARTNER PORTAL"/>
                <Label fx:id="navBrandLabel" styleClass="brand-title" text="Asanni"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="avatarLabel" styleClass="avatar-circle" text="OA"/>
        </HBox>

        <!-- ==================== MAIN CONTENT ==================== -->
        <HBox spacing="20.0" VBox.vgrow="ALWAYS">

            <!-- LEFT SIDEBAR: LIVE CONTROLS -->
            <VBox minWidth="265.0" prefWidth="265.0" spacing="14.0" styleClass="surface-card">
                <VBox spacing="6.0">
                    <Label styleClass="eyebrow-red" text="LIVE CONTROLS"/>
                    <Label styleClass="sidebar-heading" text="Table controls"/>
                    <Label styleClass="muted-text" text="Update capacity and publish changes instantly."/>
                </VBox>

                <VBox spacing="10.0">
                    <VBox.margin><Insets top="6.0"/></VBox.margin>

                    <Button onAction="#handlePlusFree" maxWidth="Infinity" styleClass="pill-action" text="+1 free">
                        <graphic>
                            <SVGPath content="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" fill="#111111" scaleX="0.75" scaleY="0.75"/>
                        </graphic>
                    </Button>

                    <Button onAction="#handleMinusFree" maxWidth="Infinity" styleClass="pill-action" text="−1 free">
                        <graphic>
                            <SVGPath content="M19 13H5v-2h14v2z" fill="#111111" scaleX="0.75" scaleY="0.75"/>
                        </graphic>
                    </Button>

                    <Button onAction="#handleSetFull" maxWidth="Infinity" styleClass="pill-action" text="Set full">
                        <graphic>
                            <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm0-14c-3.31 0-6 2.69-6 6s2.69 6 6 6 6-2.69 6-6-2.69-6-6-6z"
                                     fill="#111111" scaleX="0.7" scaleY="0.7"/>
                        </graphic>
                    </Button>
                </VBox>

                <!-- Info card -->
                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="info-card">
                    <StackPane maxWidth="-Infinity" maxHeight="-Infinity">
                        <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"
                                 fill="#8A857D" scaleX="0.6" scaleY="0.6"/>
                    </StackPane>
                    <Label styleClass="info-text" text="Publishing updates search, map and your profile immediately." wrapText="true"/>
                </HBox>
            </VBox>

            <!-- RIGHT WORKSPACE -->
            <VBox spacing="14.0" HBox.hgrow="ALWAYS">

                <!-- Live banner -->
                <HBox fx:id="liveBanner" alignment="CENTER_LEFT" spacing="12.0" styleClass="live-banner">
                    <VBox spacing="3.0">
                        <Label fx:id="liveTitleLabel" styleClass="live-title" text="Live now"/>
                        <Label fx:id="liveSubLabel" styleClass="live-sub" text="Customers see 6 free tables"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="liveBadgeLabel" styleClass="live-badge" text="● LIVE"/>
                </HBox>

                <!-- Stat row: Total tables -->
                <HBox alignment="CENTER_LEFT" styleClass="stat-row">
                    <VBox spacing="2.0">
                        <Label styleClass="stat-title" text="Total tables"/>
                        <Label styleClass="stat-sub" text="Restaurant capacity"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <HBox alignment="CENTER" spacing="10.0">
                        <Button fx:id="totalMinusBtn" onAction="#handleTotalMinus" styleClass="stepper-minus">
                            <graphic><SVGPath content="M19 13H5v-2h14v2z" fill="#6E6A63" scaleX="0.65" scaleY="0.65"/></graphic>
                        </Button>
                        <Label fx:id="totalLabel" styleClass="stepper-value" text="18"/>
                        <Button fx:id="totalPlusBtn" onAction="#handleTotalPlus" styleClass="stepper-plus">
                            <graphic><SVGPath content="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" fill="#FFFFFF" scaleX="0.65" scaleY="0.65"/></graphic>
                        </Button>
                    </HBox>
                </HBox>

                <!-- Stat row: Free tables -->
                <HBox alignment="CENTER_LEFT" styleClass="stat-row">
                    <VBox spacing="2.0">
                        <Label styleClass="stat-title" text="Free tables"/>
                        <Label styleClass="stat-sub" text="Shown to customers"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <HBox alignment="CENTER" spacing="10.0">
                        <Button fx:id="freeMinusBtn" onAction="#handleFreeMinus" styleClass="stepper-minus">
                            <graphic><SVGPath content="M19 13H5v-2h14v2z" fill="#6E6A63" scaleX="0.65" scaleY="0.65"/></graphic>
                        </Button>
                        <Label fx:id="freeLabel" styleClass="stepper-value" text="6"/>
                        <Button fx:id="freePlusBtn" onAction="#handleFreePlus" styleClass="stepper-plus">
                            <graphic><SVGPath content="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" fill="#FFFFFF" scaleX="0.65" scaleY="0.65"/></graphic>
                        </Button>
                    </HBox>
                </HBox>

                <!-- Stat row: Occupied tables (calculated, read-only) -->
                <HBox alignment="CENTER_LEFT" styleClass="stat-row">
                    <VBox spacing="2.0">
                        <Label styleClass="stat-title" text="Occupied tables"/>
                        <Label styleClass="stat-sub" text="Calculated from total"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <HBox alignment="CENTER" spacing="10.0">
                        <Button fx:id="occMinusBtn" disable="true" styleClass="stepper-minus">
                            <graphic><SVGPath content="M19 13H5v-2h14v2z" fill="#6E6A63" scaleX="0.65" scaleY="0.65"/></graphic>
                        </Button>
                        <Label fx:id="occupiedLabel" styleClass="stepper-value" text="12"/>
                        <Button fx:id="occPlusBtn" disable="true" styleClass="stepper-plus">
                            <graphic><SVGPath content="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" fill="#FFFFFF" scaleX="0.65" scaleY="0.65"/></graphic>
                        </Button>
                    </HBox>
                </HBox>

                <!-- Info card -->
                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="info-card">
                    <StackPane maxWidth="-Infinity" maxHeight="-Infinity">
                        <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"
                                 fill="#8A857D" scaleX="0.6" scaleY="0.6"/>
                    </StackPane>
                    <Label styleClass="info-text" text="Publishing updates search, map and your profile immediately." wrapText="true"/>
                </HBox>

                <Region VBox.vgrow="ALWAYS" minHeight="4"/>

                <!-- Publish button -->
                <Button fx:id="publishBtn" onAction="#handlePublish" maxWidth="Infinity"
                        styleClass="publish-btn" text="Publish 6 free tables" graphicTextGap="10.0">
                    <graphic>
                        <SVGPath content="M12 14c1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3 1.34 3 3 3zm0-4c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm6-2c0-3.31-2.69-6-6-6s-6 2.69-6 6c0 4.5 6 10 6 10s6-5.5 6-10z"
                                 fill="#FFFFFF" scaleX="0.8" scaleY="0.8" translateX="4"/>
                        <SVGPath content="M16.24 7.76l-2.12 2.12c-.78-.78-1.83-1.24-2.95-1.24s-2.17.46-2.95 1.24L6.1 7.76c1.06-1.06 2.53-1.66 4.14-1.66s3.08.6 4.14 1.66zM19.07 4.93l-2.12 2.12C15.47 5.57 13.8 4.87 12 4.87s-3.47.7-4.95 2.18L4.93 4.93C6.69 3.17 9.24 2.27 12 2.27s5.31.9 7.07 2.66z"
                                 fill="#FFFFFF" scaleX="0.8" scaleY="0.8"/>
                    </graphic>
                </Button>

                <!-- Close all tables -->
                <Button onAction="#handleCloseAll" maxWidth="Infinity" styleClass="close-btn" text="Close all tables" graphicTextGap="8.0">
                    <graphic>
                        <SVGPath content="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"
                                 fill="#111111" scaleX="0.75" scaleY="0.75"/>
                    </graphic>
                </Button>

            </VBox>
        </HBox>
    </VBox>
    </ScrollPane>

    <!-- Loading Screen Overlay -->
    <StackPane fx:id="loadingOverlay" style="-fx-background-color: #CBC7BF;">
        <VBox alignment="CENTER" spacing="20.0">
            <StackPane>
                <Circle fx:id="spinnerCircle" fill="transparent" radius="30.0" stroke="#B3262E" strokeWidth="3.0"/>
            </StackPane>
            <Label fx:id="loadingLabel" styleClass="loading-text" text="Loading..."/>
        </VBox>
    </StackPane>
</StackPane>