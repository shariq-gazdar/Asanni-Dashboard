<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<VBox prefHeight="820.0" prefWidth="1220.0" spacing="18.0"
      stylesheets="@../css/global.css, @../css/featuredlisting.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.asanni.dashboard.controllers.FeaturedListingController">

    <padding>
        <Insets bottom="24.0" left="28.0" right="28.0" top="20.0"/>
    </padding>

    <!-- ==================== TOP NAVBAR ==================== -->
    <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="top-navbar">
        <Label styleClass="logo-badge" text="AS"/>
        <VBox alignment="CENTER_LEFT" spacing="1.0">
            <Label styleClass="eyebrow-red" text="PARTNER PORTAL"/>
            <Label styleClass="brand-title" text="Asanni"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <Button onAction="#handleHelp" styleClass="pill-button-outline" text="Help" graphicTextGap="8.0">
            <graphic>
                <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17h-2v-2h2v2zm2.07-7.75l-.9.92C13.45 12.9 13 13.5 13 15h-2v-.5c0-1.1.45-2.1 1.17-2.83l1.24-1.26c.37-.36.59-.86.59-1.41 0-1.1-.9-2-2-2s-2 .9-2 2H8c0-2.21 1.79-4 4-4s4 1.79 4 4c0 .88-.36 1.68-.93 2.25z"
                         fill="#111111" scaleX="0.75" scaleY="0.75"/>
            </graphic>
        </Button>
        <Label styleClass="avatar-circle" text="OA"/>
    </HBox>

    <!-- ==================== MAIN CONTENT AREA ==================== -->
    <HBox spacing="20.0" VBox.vgrow="ALWAYS">

        <!-- LEFT SIDEBAR (ONBOARDING STEPS) -->
        <VBox prefWidth="265.0" minWidth="265.0" spacing="16.0" styleClass="surface-card">
            <VBox spacing="6.0">
                <Label styleClass="eyebrow-red" text="ONBOARDING"/>
                <Label styleClass="sidebar-heading" text="Build your featured listing"/>
                <Label styleClass="muted-text" text="Add the cover photo, short description and amenities customers see first."/>
            </VBox>

            <VBox spacing="10.0">
                <VBox.margin>
                    <Insets top="8.0"/>
                </VBox.margin>

                <!-- Step 1 -->
                <HBox fx:id="step1Card" alignment="CENTER_LEFT" spacing="12.0" styleClass="step-card" onMouseClicked="#handleStep1Click">
                    <Label styleClass="step-number-done" text="1"/>
                    <VBox spacing="2.0">
                        <Label styleClass="step-title" text="Service plan"/>
                        <Label styleClass="step-status" text="Completed"/>
                    </VBox>
                </HBox>

                <!-- Step 2 -->
                <HBox fx:id="step2Card" alignment="CENTER_LEFT" spacing="12.0" styleClass="step-card" onMouseClicked="#handleStep2Click">
                    <Label styleClass="step-number-done" text="2"/>
                    <VBox spacing="2.0">
                        <Label styleClass="step-title" text="Restaurant profile"/>
                        <Label styleClass="step-status" text="Completed"/>
                    </VBox>
                </HBox>

                <!-- Step 3 (Active) -->
                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="step-card, step-card-active">
                    <Label styleClass="step-number-active" text="3"/>
                    <VBox spacing="2.0">
                        <Label styleClass="step-title" text="Featured listing"/>
                        <Label styleClass="step-status" text="Current step"/>
                    </VBox>
                </HBox>
            </VBox>
        </VBox>

        <!-- RIGHT WORKSPACE -->
        <VBox spacing="20.0" HBox.hgrow="ALWAYS">

            <!-- TOP STEP BANNER -->
            <VBox spacing="6.0" styleClass="header-banner-card">
                <Label styleClass="eyebrow-red" text="STEP 3 OF 3"/>
                <Label styleClass="heading" text="Build your featured listing."/>
                <Label styleClass="subtitle" text="Add the cover photo, short description and amenities customers see first."/>
            </VBox>

            <!-- SPLIT BOTTOM CARDS -->
            <HBox spacing="20.0" VBox.vgrow="ALWAYS">

                <!-- LEFT CARD: COVER PHOTO -->
                <VBox prefWidth="375.0" minWidth="375.0" spacing="14.0" styleClass="surface-card">
                    <VBox spacing="4.0">
                        <Label styleClass="eyebrow-red" text="COVER PHOTO"/>
                        <Label styleClass="muted-text" text="Use a bright, inviting image that represents your restaurant."/>
                    </VBox>

                    <!-- Cover Photo URL Field -->
                    <VBox spacing="6.0">
                        <Label styleClass="section-label" text="Cover photo URL"/>
                        <TextField fx:id="coverPhotoUrlField" promptText="Enter cover photo image URL" styleClass="clean-text-field"/>
                    </VBox>

                    <!-- Image Container with Overlays -->
                    <StackPane fx:id="imageContainer" prefHeight="210.0" prefWidth="325.0">
                        <ImageView fx:id="coverImageView" fitHeight="210.0" fitWidth="325.0" preserveRatio="false"/>

                        <!-- Top-Left Badge: Cover selected -->
                        <HBox alignment="CENTER_LEFT" spacing="6.0" styleClass="cover-selected-badge"
                               maxHeight="-Infinity" maxWidth="-Infinity" StackPane.alignment="TOP_LEFT">
                            <StackPane.margin>
                                <Insets left="12.0" top="12.0"/>
                            </StackPane.margin>
                            <SVGPath content="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                                     fill="#111111" scaleX="0.65" scaleY="0.65"/>
                            <Label text="Cover selected" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                        </HBox>

                        <!-- Bottom-Right Button: Edit -->
                        <Button onAction="#handleEditCover" styleClass="edit-circle-button" StackPane.alignment="BOTTOM_RIGHT">
                            <StackPane.margin>
                                <Insets bottom="12.0" right="12.0"/>
                            </StackPane.margin>
                            <graphic>
                                <SVGPath content="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"
                                         fill="#111111" scaleX="0.7" scaleY="0.7"/>
                            </graphic>
                        </Button>
                    </StackPane>

                    <!-- Action Buttons Below Image -->
                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                        <Button onAction="#handleAddPhotos" styleClass="pill-button-outline" text="Add photos" graphicTextGap="6.0">
                            <graphic>
                                <SVGPath content="M19 5v14H5V5h14m0-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-4.86 8.86l-3 3.87L9 13.14 6 17h12l-3.86-5.14z"
                                         fill="#111111" scaleX="0.75" scaleY="0.75"/>
                            </graphic>
                        </Button>

                        <Button onAction="#handleReorder" styleClass="pill-button-outline" text="Reorder" graphicTextGap="6.0">
                            <graphic>
                                <SVGPath content="M4 8h4V4H4v4zm6 12h4v-4h-4v4zm-6 0h4v-4H4v4zm0-6h4v-4H4v4zm6 0h4v-4h-4v4zm6-10v4h4V4h-4zm-6 4h4V4h-4v4zm6 6h4v-4h-4v4zm0 6h4v-4h-4v4z"
                                         fill="#111111" scaleX="0.75" scaleY="0.75"/>
                            </graphic>
                        </Button>
                    </HBox>

                    <!-- Photo Counter -->
                    <HBox alignment="CENTER_RIGHT">
                        <Label fx:id="photoCountLabel" styleClass="muted-text" text="4 of 8"/>
                    </HBox>
                </VBox>

                <!-- RIGHT CARD: DETAILS & PUBLISH -->
                <VBox spacing="20.0" styleClass="surface-card" HBox.hgrow="ALWAYS">

                    <!-- Short Description -->
                    <VBox spacing="8.0">
                        <Label styleClass="section-label" text="Short description"/>
                        <TextField fx:id="descriptionField" promptText="Enter a short description" maxWidth="Infinity" styleClass="clean-text-field"/>
                    </VBox>

                    <!-- Featured Preview Section -->
                    <VBox spacing="10.0">
                        <VBox.margin>
                            <Insets top="8.0"/>
                        </VBox.margin>

                        <HBox alignment="CENTER_LEFT">
                            <Label styleClass="eyebrow-red" text="FEATURED PREVIEW"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button onAction="#handleOpenPreview" styleClass="icon-button-transparent">
                                <graphic>
                                    <SVGPath content="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"
                                             fill="#555555" scaleX="0.75" scaleY="0.75"/>
                                </graphic>
                            </Button>
                        </HBox>

                        <HBox alignment="CENTER_LEFT">
                            <VBox spacing="2.0">
                                <Label styleClass="brand-title" text="Asanni"/>
                                <Label styleClass="muted-text" text="Mediterranean · Zamzama"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="statusBadge" styleClass="status-badge-not-live" text="●  Not live"/>
                        </HBox>
                    </VBox>

                    <!-- Publish Button -->
                    <Button fx:id="publishButton" maxWidth="Infinity" onAction="#handlePublishProfile"
                            styleClass="publish-button" text="Publish profile" graphicTextGap="10.0">
                        <VBox.margin>
                            <Insets top="6.0"/>
                        </VBox.margin>
                        <graphic>
                            <SVGPath content="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"
                                     fill="#FFFFFF" scaleX="0.75" scaleY="0.75"/>
                        </graphic>
                    </Button>

                </VBox>
            </HBox>
        </VBox>
    </HBox>
</VBox>